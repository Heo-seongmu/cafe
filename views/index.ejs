<!DOCTYPE html>
<html lang="ko">
<head><meta charset="UTF-8"><title>카페 메뉴</title></head>
<body>
  <h1>카페 메뉴 관리</h1>
  <form action="/add" method="post">
    <input name="name" placeholder="메뉴명" required>
    <input name="price" type="number" placeholder="가격" required>
    <input name="category" placeholder="분류">
    <button>추가</button>
  </form>
  <br>
  <table border="1" cellpadding="8">
    <tr><th>ID</th><th>메뉴명</th><th>가격</th><th>분류</th><th>관리</th></tr>
    <% menus.forEach(m => { %>
    <tr>
      <td><%= m.id %></td>
      <td><%= m.name %></td>
      <td><%= m.price %>원</td>
      <td><%= m.category %></td>
      <td>
        <a href="/edit/<%= m.id %>">수정</a>
        <a href="/delete/<%= m.id %>" onclick="return confirm('삭제할까요?')">삭제</a>
      </td>
    </tr>
    <% }) %>
  </table>
</body>
</html>